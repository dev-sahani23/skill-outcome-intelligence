# Server
NODE_ENV=production
PORT=10000

# Database — get from Neon dashboard
DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require

# Redis — get from Upstash dashboard (use REDIS_URL, not TLS URL)
REDIS_URL=rediss://default:password@host.upstash.io:6380

# JWT
JWT_SECRET=minimum_32_char_random_string_replace_this

# Email (Gmail)
EMAIL_PROVIDER=gmail
GMAIL_USER=your-project-email@gmail.com
GMAIL_APP_PASSWORD=your_app_password
MOCK_EMAIL=false

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_PERMANENT_system_user_token
WHATSAPP_VERIFY_TOKEN=skillportal_webhook_secret_2007
MOCK_WHATSAPP=false

# Groq
GROQ_API_KEY=your_groq_api_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for CORS)
FRONTEND_URL=https://your-app.vercel.app
